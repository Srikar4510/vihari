# Copy to backend/.env for local development. On Render, add the same keys under Environment.

# --- Required ---
# MongoDB connection string (local: mongodb://127.0.0.1:27017/vihari, cloud: MongoDB Atlas "Connect > Drivers")
MONGO_URI=mongodb://127.0.0.1:27017/vihari
# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Website address(es) allowed to call the API, comma-separated (leave empty locally to allow any)
FRONTEND_URL=

# --- Optional ---
# Port (hosts like Render set this automatically)
PORT=4000
# Public address of this API, shown in the API docs at /api-docs
PUBLIC_API_URL=
# Photo and document storage. Without it files go to backend/uploads (fine locally, wiped on most hosts).
# Cloudinary dashboard > API Keys > "API environment variable": cloudinary://<key>:<secret>@<cloud_name>
CLOUDINARY_URL=
# Redis cache for the tours list (e.g. Upstash: rediss://default:<password>@<host>:6379). Optional.
REDIS_URL=
# Email for partner approvals and admin announcements (Gmail address + 16-character app password). Optional.
MAIL_USER=
MAIL_PASS=
# Razorpay test keys. Leave empty to use demo payments (no money is taken).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Password for the local demo accounts created by "npm run seed" (default: password123)
SEED_PASSWORD=
# Production admin created by "npm run seed:admin" (password: 10+ characters)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
